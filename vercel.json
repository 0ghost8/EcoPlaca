{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist/frontend/browser",
  "routes": [
    {
      "src": "/api(/.*)?",
      "dest": "https://ecoplaca-production.up.railway.app/api$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)).*",
      "dest": "/index.html"
    }
  ]
}
